# Backend settings. Source this file from the repository root before launching FastAPI.
FLOWPILOT_SEED=true
OLLAMA_ENABLED=false
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_URL=http://127.0.0.1:11434
# FLOWPILOT_DB=/absolute/path/to/flowpilot.db
# Set this in the environment of the Ollama server if you opt in.
OLLAMA_NO_CLOUD=1
# See frontend/.env.example for the optional backend origin override.
